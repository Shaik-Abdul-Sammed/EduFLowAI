# ==============================================================================
# EduFlow AI OS — Backend Production Environment Configuration (.env.production)
# Populate these environment variables in your production host (e.g. Render Dashboard)
# ==============================================================================

# Core Application Runtime
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# Database Connection (Render-managed PostgreSQL with SSL)
# NOTE: Production must use the 'eduflow' database (not 'postgres'). Before Render deploy, ensure 'eduflow' DB is created and migrated.
DATABASE_URL=postgres://eduflow:password@host.singapore.render.com:5432/eduflow
DB_MODE=postgres

# Cryptographic Tokens (Generate with: openssl rand -hex 32)
JWT_SECRET=generate-a-random-64-char-string-for-production-jwt-auth
JWT_REFRESH_SECRET=generate-a-random-64-char-string-for-production-refresh
JWT_EXPIRES_IN=15m

# AI Provider Configuration
# Supported providers: gemini | openai | claude | ollama
AI_PROVIDER=gemini
AI_MODEL=gemini-3.5-flash
AI_API_KEY=your-production-gemini-or-openai-api-key
OPENAI_API_KEY=optional-fallback-openai-api-key

# Client Application URLs & CORS Policy
CORS_ORIGIN=https://eduflow-web.onrender.com
APP_PUBLIC_URL=https://eduflow-web.onrender.com

# Production Rate Limiter Tuning
RATE_LIMIT_MAX_AUTH=100
RATE_LIMIT_MAX_UNAUTH=20
RATE_LIMIT_WINDOW_MS=900000

# Automation Business & Operations
LEAD_NOTIFICATION_EMAIL=admin@eduflow.app
COMPANY_ADDRESS="Hyderabad, India"
COMPANY_GST=
BANK_DETAILS=State Bank of India | Contact admin@eduflow.app for billing remittances
