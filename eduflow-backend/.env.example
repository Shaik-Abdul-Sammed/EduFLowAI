# === EduFlow AI OS Backend ===
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/eduflow
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-this-to-a-very-long-random-secret
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# ============================================
# AI PROVIDER (swap without code changes)
# ============================================
# Options: gemini | openai | claude | ollama | lmstudio
AI_PROVIDER=gemini
# API key for cloud providers
AI_API_KEY=your-api-key-here
# Override model name (optional, each provider has defaults)
AI_MODEL=
# Base URL for local providers (ollama/lmstudio)
AI_BASE_URL=

# ============================================
# STORAGE
# ============================================
STORAGE_TYPE=local
STORAGE_LOCAL_PATH=./uploads

# ============================================
# INSTITUTION DATA COLLECTOR
# ============================================
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
SCRAPER_USER_AGENT=EduFlowBot/1.0 (+https://eduflow-web.onrender.com/about)
SCRAPER_MAX_PAGES=20
SCRAPER_TIMEOUT_MS=15000
SCRAPER_RATE_LIMIT_MS=1000
