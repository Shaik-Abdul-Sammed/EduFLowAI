# ==============================================================================
# EduFlow AI OS — On-Premise Environment Configuration
# ==============================================================================

# Campus Networking
CAMPUS_DOMAIN=eduflow.campus.internal
PORT=3000
NODE_ENV=production

# Database Settings (PostgreSQL 16)
POSTGRES_DB=eduflow
POSTGRES_USER=eduflow_admin
POSTGRES_PASSWORD=ChangeThisSecureDbPassword2026!

# Cryptographic Secrets (Generate via `openssl rand -hex 32`)
JWT_SECRET=f3a819b1682e88a0e9b9409b3c4155d0458e0a3b2b7194cbcfef30948ac72a1e
JWT_REFRESH_SECRET=7cb94285e6db24bf20a0bf05b184132c3c6f8f1dfec893051d950f28e21aa204

# Local AI Provider (Ollama Air-Gapped)
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3:8b-instruct

# Security & Multi-Tenancy
ROW_LEVEL_SECURITY=enabled
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_AUTH=500
RATE_LIMIT_MAX_UNAUTH=50

# Institutional Directory Integration (Optional)
LDAP_URL=ldap://ldap.campus.internal:389
LDAP_BIND_DN=cn=eduflow_bind,ou=services,dc=campus,dc=internal
LDAP_BIND_PASSWORD=LdapServicePassword2026!
LDAP_BASE_DN=ou=people,dc=campus,dc=internal
